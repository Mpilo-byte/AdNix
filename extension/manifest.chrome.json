{
    "manifest_version": 3,
    "name": "AdNix",
    "version": "0.1.0",
    "description": "Open-source ad blocking and privacy protection.",
    "permissions": ["declarativeNetRequest"],
    "declarative_net_request": {
        "rule_resources": [
            { "id": "ads", "enabled": true, "path": "rules/ads.json" },
            { "id": "trackers", "enabled": true, "path": "rules/trackers.json" }
        ]
    },
    "content_scripts": [
        {
            "matches": ["<all_urls>"],
            "js": ["src/cosmetic-rules.js", "src/content.js"],
            "run_at": "document_start",
            "all_frames": true
        }
    ],
    "background": {
        "service_worker": "src/background.js"
    }
}